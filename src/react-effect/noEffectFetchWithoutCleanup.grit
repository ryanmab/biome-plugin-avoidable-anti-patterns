language js

`useEffect(() => { $body }, $...)` as $effect where {
	$effect <: within JsFunctionBody(statements=$stmts) ,
	// Effect is likely used for data fetching
	or {
		$body <: contains `fetch($_)`,
		$body <: contains `fetch()`,
		$body <: contains `axios($_)`,
		$body <: contains `axios()`,
		$body <: contains `axios.$method($_)`,
		$body <: contains `axios.$method()`,
		$body <: contains `$client.get($_)`,
		$body <: contains `$client.get()`,
		$body <: contains `$client.post($_)`,
		$body <: contains `$client.post()`,
		$body <: contains `$client.put($_)`,
		$body <: contains `$client.put()`,
		$body <: contains `$client.delete($_)`,
		$body <: contains `$client.delete()`,
		$body <: contains `$client.patch($_)`,
		$body <: contains `$client.patch()`,
		$body <: contains `$client.request($_)`,
		$body <: contains `$client.request()`,
		$body <: contains `$.ajax($_)`,
		$body <: contains `$.ajax()`,
		$body <: contains `$.get($_)`,
		$body <: contains `$.get()`,
		$body <: contains `$.post($_)`,
		$body <: contains `$.post()`,
		$body <: contains `api.$method($_)`,
		$body <: contains `api.$method()`,
		$body <: contains `api.get($_)`,
		$body <: contains `api.get()`,
		$body <: contains `api.post($_)`,
		$body <: contains `api.post()`,
		$body <: contains `api.put($_)`,
		$body <: contains `api.put()`,
		$body <: contains `api.delete($_)`,
		$body <: contains `api.delete()`,
		$body <: contains `api.patch($_)`,
		$body <: contains `api.patch()`
	},
	// Effect does not run a cleanup on unmount
	$body <: not [
		...,

		JsReturnStatement()
	],
	register_diagnostic(span=$effect, severity="error", message="This effect performs network requests with no cleanup function, so a fast dependency change can apply a stale response. Consider adding an `ignore` flag which is filled in a cleanup function, or use a framework for data-fetching: https://react.dev/learn/you-might-not-need-an-effect#fetching-data")
}
