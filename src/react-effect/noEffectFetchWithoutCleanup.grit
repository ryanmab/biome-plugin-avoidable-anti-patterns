language js

`useEffect(() => { $body }, $...)` as $effect where {
	$effect <: within JsFunctionBody(statements=$stmts) ,
	// Effect is likely used for data fetching
	or {
		// Effect uses the Fetch API (either directly via node-fetch, or indirectly by global)
		$body <: contains `$callback($...)` where any {
			$program <: contains `import $callback from 'node-fetch'`,
			and {
				$callback <: `fetch`,
				$program <: not contains JsVariableDeclarator(id=`fetch`)
			}
		},
		// Effect uses axios
		$body <: contains or {
			`$callback($...)`,
			`$callback.$method($...)`
		} where { $program <: contains `import $callback from 'axios'` },
		// Effect uses jQuery
		$body <: contains or {
			contains `$callback.ajax($...)`,
			contains `$callback.get($...)`,
			contains `$callback.post($...)`
		} where { $program <: contains `import $callback from 'jquery'` }
	},
	// Effect does not run a cleanup on unmount
	$body <: not [
		...,

		JsReturnStatement()
	],
	register_diagnostic(span=$effect, severity="error", message="This effect performs network requests with no cleanup function, so a fast dependency change can apply a stale response. Consider adding an `ignore` flag which is filled in a cleanup function, or use a framework for data-fetching: https://react.dev/learn/you-might-not-need-an-effect#fetching-data")
}
